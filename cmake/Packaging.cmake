set(CPACK_PACKAGE_NAME "CassetteCat")
set(CPACK_PACKAGE_VENDOR "CassetteCat contributors")
set(CPACK_PACKAGE_CONTACT "https://github.com/samyyy2311/CassetteCat-Desktop/issues")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "A local-first desktop music player")
set(CPACK_PACKAGE_VERSION "${CASSETTECAT_PACKAGE_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "CassetteCat-${CASSETTECAT_PACKAGE_VERSION}-${CMAKE_SYSTEM_NAME}")

set(CPACK_GENERATOR "TGZ;DEB;RPM")
set(CPACK_COMPONENTS_ALL runtime)
set(CPACK_DEBIAN_PACKAGE_NAME "cassettecat")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "CassetteCat contributors")
set(CPACK_DEBIAN_PACKAGE_HOMEPAGE "https://github.com/samyyy2311/CassetteCat-Desktop")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "amd64")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_RPM_PACKAGE_NAME "cassettecat")
set(CPACK_RPM_PACKAGE_ARCHITECTURE "x86_64")
set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-or-later")

set(CPACK_DEBIAN_PACKAGE_VERSION "${CASSETTECAT_PACKAGE_VERSION}")
set(CPACK_RPM_PACKAGE_VERSION "${CASSETTECAT_PACKAGE_VERSION}")
if(CASSETTECAT_PACKAGE_VERSION MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)-(.+)$")
    set(CPACK_DEBIAN_PACKAGE_VERSION "${CMAKE_MATCH_1}~${CMAKE_MATCH_2}")
    set(CPACK_RPM_PACKAGE_VERSION "${CMAKE_MATCH_1}")
    set(CPACK_RPM_PACKAGE_RELEASE "0.${CMAKE_MATCH_2}")
endif()

include(CPack)
