<component type="desktop-application">
  <id>io.github.samyyy2311.CassetteCat</id>
  <name>CassetteCat</name>
  <summary>Local-first desktop music player</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/samyyy2311/CassetteCat-Desktop</url>
